        "query": {
          "data_source_id": "Walmart_Sales",
          "sql": "SELECT SUM(value) AS value FROM (SELECT period, segment, category, value, substr(period,1,4) AS year FROM (SELECT substr(Date,7,4)||'-'||substr(Date,4,2) AS period, CAST(Store AS TEXT) AS segment, CASE Holiday_Flag WHEN 1 THEN '节假日' ELSE '普通周' END AS category, SUM(Weekly_Sales) AS value FROM walmart_sales GROUP BY 1,2,3) facts) dataset WHERE (:year='all' OR year=:year) AND (:segment='all' OR segment=:segment)",
