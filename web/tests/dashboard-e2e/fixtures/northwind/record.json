    "widgets": [
      {
        "id": "retention",
        "type": "bar",
        "title": "客户首购与复购留存",
        "description": "按首购年份及首次购买地区筛选；人数去重。未观察到的后续周期显示为未到期。数据观察截止于源数据最后一笔订单。",
        "query": {
          "data_source_id": "upload_001_3a6ee8a2d1ad4a2a",
          "sql": "SELECT cohort,age,SUM(retained) AS retained,SUM(cohort_size) AS cohort_size,MIN(observed) AS observed FROM (WITH facts AS (SELECT event_date,substr(event_date,1,7) AS period,substr(event_date,1,4) AS year,COALESCE(segment,'未分类') AS segment,COALESCE(category,'未分类') AS category,value,entity,aux FROM (SELECT date(o.orderDate) AS event_date,o.shipCountry AS segment,c.companyName AS category,1.0 AS value,CAST(o.customerID AS TEXT) AS entity,NULL AS aux FROM orders o JOIN customers c ON o.customerID=c.customerID) source_facts),\n      events AS (SELECT entity,segment,event_date,substr(event_date,1,7)||'-01' AS period FROM facts),\n      first_dates AS (SELECT entity,MIN(event_date) AS first_date FROM events GROUP BY entity),\n      members AS (SELECT e.entity,MIN(e.segment) AS segment,MIN(e.period) AS cohort FROM events e JOIN first_dates f ON e.entity=f.entity AND e.event_date=f.first_date GROUP BY e.entity),\n      sizes AS (SELECT cohort,segment,COUNT(*) AS cohort_size FROM members GROUP BY cohort,segment),\n      active AS (SELECT m.cohort,m.segment,(CAST(substr(e.period,1,4) AS INTEGER)-CAST(substr(m.cohort,1,4) AS INTEGER))*12+CAST(substr(e.period,6,2) AS INTEGER)-CAST(substr(m.cohort,6,2) AS INTEGER) AS age,COUNT(DISTINCT e.entity) AS retained FROM members m JOIN events e ON m.entity=e.entity GROUP BY m.cohort,m.segment,age),\n      ages AS (SELECT 0 AS age UNION ALL SELECT 1 AS age UNION ALL SELECT 2 AS age UNION ALL SELECT 3 AS age UNION ALL SELECT 4 AS age UNION ALL SELECT 5 AS age UNION ALL SELECT 6 AS age UNION ALL SELECT 7 AS age UNION ALL SELECT 8 AS age UNION ALL SELECT 9 AS age UNION ALL SELECT 10 AS age UNION ALL SELECT 11 AS age UNION ALL SELECT 12 AS age), horizon AS (SELECT MAX(period) AS last_period FROM events)\n      SELECT s.cohort,substr(s.cohort,1,4) AS year,s.segment,a.age,s.cohort_size,\n        COALESCE(r.retained,0) AS retained,CASE WHEN a.age<=(CAST(substr(h.last_period,1,4) AS INTEGER)-CAST(substr(s.cohort,1,4) AS INTEGER))*12+CAST(substr(h.last_period,6,2) AS INTEGER)-CAST(substr(s.cohort,6,2) AS INTEGER) THEN 1 ELSE 0 END AS observed\n      FROM sizes s CROSS JOIN ages a CROSS JOIN horizon h\n      LEFT JOIN active r ON r.cohort=s.cohort AND r.segment=s.segment AND r.age=a.age) cohort_data WHERE (:year='all' OR year=:year) AND (:segment='all' OR segment=:segment) GROUP BY cohort,age ORDER BY cohort,age",
          "federation": null,
          "filter_parameters": {
            "year": {
              "parameter": "year",
              "start_parameter": null,
              "end_parameter": null
            },
