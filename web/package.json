{
  "name": "db-gpt-web",
  "version": "0.1.0",
  "private": true,
  "description": "DB-GPT WebUI",
  "repository": "https://github.com/eosphoros-ai/DB-GPT-Web.git",
  "license": "ISC",
  "author": "",
  "main": "next.config.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "node scripts/build-web.cjs",
    "build:prod": "node scripts/build-web.cjs --production-env",
    "compile": "node scripts/build-web.cjs --export",
    "dev": "node scripts/run-next.cjs dev --webpack",
    "export": "npm run compile",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node scripts/run-next.cjs start",
    "test": "npm run test:react-final && npm run test:final-presentation",
    "test:build": "node --test next.config.test.cjs scripts/verify-next-build-assets.test.cjs scripts/prepare-build-types.test.cjs scripts/toolchain-regressions.test.cjs lib/session.test.cjs scripts/wiki-locales.test.cjs",
    "test:final-presentation": "tsc --target ES2020 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --strict --outDir node_modules/.cache/final-presentation-tests utils/final-presentation.ts utils/final-presentation.test.ts && node node_modules/.cache/final-presentation-tests/final-presentation.test.js",
    "test:react-final": "tsc --target ES2020 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --strict --outDir node_modules/.cache/react-final-tests utils/react-agent-final.ts utils/react-agent-final.test.ts && node node_modules/.cache/react-final-tests/react-agent-final.test.js",
    "typecheck": "node scripts/typecheck.cjs",
    "test:dashboard": "vitest run --config vitest.dashboard.config.mts",
    "verify:dashboard": "npm run test:build && npm run typecheck && npm run lint && npm run test:dashboard && npm run build",
    "test:e2e:dashboard": "playwright test --config playwright.dashboard.config.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.18.4",
    "@ant-design/icons": "^5.2.5",
    "@ant-design/plots": "^2.2.5",
    "@antv/algorithm": "^0.1.26",
    "@antv/ava": "3.5.0-alpha.4",
    "@antv/g2": "^5.1.8",
    "@antv/g6": "^5.0.17",
    "@antv/gpt-vis": "^0.0.5",
    "@antv/graphin": "^3.0.2",
    "@antv/s2": "^1.51.2",
    "@berryv/g2-react": "^0.1.0",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@monaco-editor/react": "^4.5.2",
    "@mui/icons-material": "^5.11.16",
    "@mui/joy": "5.0.0-beta.5",
    "@mui/material": "^5.15.20",
    "@oceanbase-odc/monaco-plugin-ob": "^1.0.3",
    "@types/react-virtualized": "^9.21.29",
    "@uiw/react-json-view": "^2.0.0-alpha.23",
    "ahooks": "^3.7.8",
    "antd": "^5.10.0",
    "axios": "^1.3.4",
    "classnames": "^2.3.2",
    "cookies-next": "^4.0.0",
    "copy-to-clipboard": "^3.3.3",
    "cytoscape": "^3.29.2",
    "cytoscape-euler": "^1.2.2",
    "dayjs": "^1.11.12",
    "framer-motion": "^10.16.4",
    "google-auth-library": "^9.2.0",
    "google-one-tap": "^1.0.6",
    "html2canvas": "^1.4.1",
    "i18next": "^23.4.5",
    "iron-session": "8.0.4",
    "jspdf": "^4.1.0",
    "katex": "^0.16.21",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "moment": "^2.29.4",
    "monaco-editor": ">=0.31.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.2",
    "nanoid": "3.3.18",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "next-connect": "^1.0.0-next.4",
    "nprogress": "^0.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^13.2.0",
    "react-markdown-editor-lite": "^1.3.4",
    "react-syntax-highlighter": "16.1.1",
    "react-virtualized": "^9.22.5",
    "reactflow": "^11.10.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sequelize": "^6.33.0",
    "sql-formatter": "^12.2.4",
    "tailwindcss": "3.3.2",
    "tailwindcss-animated": "^1.0.1",
    "typescript": "5.9.3",
    "uuid": "11.1.1",
    "ajv": "^8.20.0",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "9.0.1",
    "react-resizable": "3.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.2",
    "@types/google-one-tap": "^1.2.4",
    "@types/lodash": "^4.14.195",
    "@types/markdown-it": "^14.1.1",
    "@types/node": "20.19.43",
    "@types/node-localstorage": "^1.3.2",
    "@types/nprogress": "^0.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "autoprefixer": "10.4.14",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "graceful-fs": "^4.2.11",
    "husky": "^9.1.5",
    "lint-staged": "16.2.7",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "prettier-plugin-packagejson": "^2.5.2",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.62.0",
    "jsdom": "^26.1.0",
    "vitest": "4.1.10"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10 <11"
  },
  "overrides": {
    "fmin": {
      "rollup": "2.80.0"
    },
    "react-markdown-editor-lite": {
      "nanoid": "$nanoid"
    },
    "sequelize": {
      "uuid": "$uuid"
    },
    "cosmiconfig": {
      "yaml": "1.10.3"
    }
  }
}
