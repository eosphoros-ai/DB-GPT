{
  "flow": {
    "uid": "",
    "label": "通用快速取数",
    "name": "taskflow_quick_query_template",
    "flow_category": "chat_flow",
    "description": "按业务口径快速定位数据并执行有界只读查询，AI 生成含关键数字的结论。",
    "state": "running",
    "define_type": "json",
    "flow_format": "taskflow",
    "editable": false,
    "taskflow_source": {
      "format": "taskflow/1",
      "nodes": [
        {
          "id": "n1",
          "kind": "start",
          "config": {}
        },
        {
          "id": "n2",
          "kind": "db_query",
          "config": {
            "datasource": "case_1_student_manager",
            "max_rows": 50
          }
        },
        {
          "id": "n3",
          "kind": "ai_analysis",
          "config": {
            "analysis_prompt": "用 1-2 句话直接回答用户的问题，必须包含关键数字与结论。"
          }
        },
        {
          "id": "n4",
          "kind": "output",
          "config": {}
        }
      ],
      "edges": [
        [
          "n1",
          "n2"
        ],
        [
          "n2",
          "n3"
        ],
        [
          "n3",
          "n4"
        ]
      ]
    }
  }
}