{
  "flow": {
    "uid": "",
    "label": "多 Agent 数据分析流(CSV)",
    "name": "taskflow_agent_csv_analysis_template",
    "flow_category": "chat_flow",
    "description": "上传 CSV → 画像与计划 → 透视分析 → 数字复核 → 可视化 → 报告,四个 Agent 分工协作的表格分析流程。",
    "state": "running",
    "define_type": "json",
    "flow_format": "taskflow",
    "editable": false,
    "taskflow_source": {
      "format": "taskflow/1",
      "nodes": [
        {
          "id": "n1",
          "kind": "start",
          "config": {}
        },
        {
          "id": "n2",
          "kind": "file_data",
          "label": "数据文件",
          "config": {
            "file_name": "upload_your_data.xlsx",
            "max_rows": 1000
          }
        },
        {
          "id": "n3",
          "kind": "agent",
          "label": "画像与分析计划",
          "config": {
            "agent_profile": "react_data",
            "goal": "先对上游数据集做画像:每个字段的含义与类型、行数、缺失与异常、可分析维度;然后结合用户问题,提出 3-5 个最有业务价值的分析问题(写清指标口径)。输出:画像摘要 + 分析计划清单,不要开始分析。",
            "tools": ["code_interpreter"],
            "skills": ["excel-analyzer"],
            "max_turns": 6
          }
        },
        {
          "id": "n4",
          "kind": "agent",
          "label": "透视分析",
          "config": {
            "agent_profile": "react_data",
            "goal": "按上游分析计划逐个问题回答:用 code_interpreter 对数据做分组、聚合、透视;每个问题给出结论 + 关键数字 + 一句解释;最后汇总为结构化分析结论。",
            "tools": ["code_interpreter"],
            "skills": ["excel-analyzer"],
            "max_turns": 10
          }
        },
        {
          "id": "n5",
          "kind": "agent",
          "label": "数字复核",
          "config": {
            "agent_profile": "react_data",
            "goal": "对上游分析结论中的关键数字,用代码对原始数据独立重算,不得直接采信上游计算过程;逐项标注「确认 / 修正」与差异说明。输出复核表。",
            "tools": ["code_interpreter"],
            "max_turns": 8
          }
        },
        {
          "id": "n6",
          "kind": "visualize",
          "config": {
            "max_charts": 4
          }
        },
        {
          "id": "n7",
          "kind": "agent",
          "label": "分析报告",
          "config": {
            "agent_profile": "react_general",
            "goal": "把上游的画像、分析结论、复核意见组织成一份面向业务读者的分析报告:标题、核心结论(不超过 3 条)、关键数据、趋势与异常、可执行建议。数字以复核后的为准。",
            "tools": [],
            "max_turns": 4
          }
        },
        {
          "id": "n8",
          "kind": "output",
          "config": {}
        }
      ],
      "edges": [
        ["n1", "n2"],
        ["n2", "n3"],
        ["n3", "n4"],
        ["n4", "n5"],
        ["n5", "n6"],
        ["n6", "n7"],
        ["n7", "n8"]
      ]
    }
  }
}
