{
  "flow": {
    "uid": "",
    "label": "数据分析流",
    "name": "taskflow_data_analysis_template",
    "flow_category": "chat_flow",
    "description": "执行数据读取、分析计算、可视化与报告生成的完整分析流程，适合常规经营分析。",
    "state": "running",
    "define_type": "json",
    "flow_format": "taskflow",
    "editable": false,
    "taskflow_source": {
      "format": "taskflow/1",
      "nodes": [
        { "id": "n1", "kind": "start", "config": {} },
        {
          "id": "n2",
          "kind": "db_query",
          "config": { "datasource": "case_1_student_manager", "max_rows": 1000 }
        },
        {
          "id": "n3",
          "kind": "ai_analysis",
          "config": {
            "analysis_prompt": "关注趋势变化与同比/环比，识别异常波动并给出可能原因。"
          }
        },
        {
          "id": "n4",
          "kind": "visualize",
          "config": { "datasource": "case_1_student_manager", "max_charts": 4 }
        },
        {
          "id": "n5",
          "kind": "human_confirm",
          "config": { "message": "请确认分析结论口径，确认后生成报告" }
        },
        { "id": "n6", "kind": "report", "config": {} },
        { "id": "n7", "kind": "output", "config": {} }
      ],
      "edges": [
        ["n1", "n2"],
        ["n2", "n3"],
        ["n3", "n4"],
        ["n4", "n5"],
        ["n5", "n6"],
        ["n6", "n7"]
      ]
    }
  }
}
