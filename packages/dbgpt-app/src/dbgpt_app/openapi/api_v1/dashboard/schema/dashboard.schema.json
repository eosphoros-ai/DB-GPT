{
  "$defs": {
    "AgentGenerationInfo": {
      "additionalProperties": false,
      "properties": {
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        }
      },
      "title": "AgentGenerationInfo",
      "type": "object"
    },
    "ChartEncoding": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "angle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Angle"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "y2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        },
        "row": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "title": "ChartEncoding",
      "type": "object"
    },
    "DashboardAnomalyBaseline": {
      "enum": [
        "previous_period",
        "rolling_average",
        "target_value"
      ],
      "title": "DashboardAnomalyBaseline",
      "type": "string"
    },
    "DashboardAnomalyDirection": {
      "enum": [
        "two_sided",
        "above",
        "below"
      ],
      "title": "DashboardAnomalyDirection",
      "type": "string"
    },
    "DashboardAnomalyRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/DashboardAnomalyBaseline"
        },
        "value_field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Value Field",
          "type": "string"
        },
        "time_field": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Field"
        },
        "direction": {
          "$ref": "#/$defs/DashboardAnomalyDirection",
          "default": "two_sided"
        },
        "threshold": {
          "$ref": "#/$defs/DashboardAnomalyThreshold"
        },
        "rolling_window": {
          "default": 3,
          "maximum": 100,
          "minimum": 2,
          "title": "Rolling Window",
          "type": "integer"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Value"
        },
        "min_samples": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Min Samples",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "baseline",
        "value_field"
      ],
      "title": "DashboardAnomalyRule",
      "type": "object"
    },
    "DashboardAnomalyThreshold": {
      "additionalProperties": false,
      "description": "Owner-configured decision threshold; no detector percentage is implicit.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DashboardAnomalyThresholdMode",
          "default": "relative_change"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "DashboardAnomalyThreshold",
      "type": "object"
    },
    "DashboardAnomalyThresholdMode": {
      "enum": [
        "relative_change",
        "absolute_change"
      ],
      "title": "DashboardAnomalyThresholdMode",
      "type": "string"
    },
    "DashboardDefaultSort": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "direction": {
          "$ref": "#/$defs/DashboardSortDirection",
          "default": "default"
        }
      },
      "title": "DashboardDefaultSort",
      "type": "object"
    },
    "DashboardDescriptor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "data_source_id": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Data Source Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DashboardStatus",
          "default": "draft"
        },
        "theme": {
          "$ref": "#/$defs/DashboardVisualTheme"
        },
        "refresh_policy": {
          "$ref": "#/$defs/DashboardRefreshPolicy"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "title",
        "data_source_id"
      ],
      "title": "DashboardDescriptor",
      "type": "object"
    },
    "DashboardFilter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/FilterType"
        },
        "label": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/FilterOption"
          },
          "title": "Options",
          "type": "array"
        },
        "relative_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeDateRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "field"
      ],
      "title": "DashboardFilter",
      "type": "object"
    },
    "DashboardLayouts": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "default": 12,
          "maximum": 12,
          "minimum": 12,
          "title": "Columns",
          "type": "integer"
        },
        "desktop": {
          "items": {
            "$ref": "#/$defs/LayoutItem"
          },
          "title": "Desktop",
          "type": "array"
        },
        "mobile_strategy": {
          "default": "stack",
          "title": "Mobile Strategy",
          "type": "string"
        }
      },
      "title": "DashboardLayouts",
      "type": "object"
    },
    "DashboardMetadata": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "source_turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Turn Id"
        },
        "agent": {
          "$ref": "#/$defs/AgentGenerationInfo"
        },
        "compatibility": {
          "additionalProperties": true,
          "title": "Compatibility",
          "type": "object"
        }
      },
      "title": "DashboardMetadata",
      "type": "object"
    },
    "DashboardPresentation": {
      "additionalProperties": false,
      "description": "Validated visualization settings introduced by Schema 1.3.",
      "properties": {
        "visualization": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardVisualization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "orientation": {
          "anyOf": [
            {
              "pattern": "^(vertical|horizontal)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        },
        "stacked": {
          "default": false,
          "title": "Stacked",
          "type": "boolean"
        },
        "smooth": {
          "default": true,
          "title": "Smooth",
          "type": "boolean"
        },
        "top_n": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top N"
        },
        "colors": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Colors",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "precision": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "percentage": {
          "default": false,
          "title": "Percentage",
          "type": "boolean"
        },
        "show_legend": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Show Legend"
        },
        "show_grid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Show Grid"
        },
        "default_sort": {
          "$ref": "#/$defs/DashboardDefaultSort"
        }
      },
      "title": "DashboardPresentation",
      "type": "object"
    },
    "DashboardPublicationAggregation": {
      "enum": [
        "sum",
        "average",
        "count",
        "count_distinct",
        "minimum",
        "maximum",
        "first",
        "ratio"
      ],
      "title": "DashboardPublicationAggregation",
      "type": "string"
    },
    "DashboardPublicationBinding": {
      "additionalProperties": false,
      "description": "Safe materialization recipe used only while the owner publishes.\n\nThe query result is frozen with the published revision.  Anonymous filtering\nlater operates only on those rows and never receives a database connector.",
      "properties": {
        "query": {
          "$ref": "#/$defs/WidgetQueryBinding"
        },
        "filter_fields": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/DashboardPublicationFilterBinding"
              }
            ]
          },
          "title": "Filter Fields",
          "type": "object"
        },
        "group_by": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Group By",
          "type": "array"
        },
        "measures": {
          "items": {
            "$ref": "#/$defs/DashboardPublicationMeasure"
          },
          "maxItems": 20,
          "title": "Measures",
          "type": "array"
        },
        "output_columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Output Columns",
          "type": "array"
        },
        "row_mode": {
          "default": false,
          "title": "Row Mode",
          "type": "boolean"
        },
        "sort": {
          "items": {
            "$ref": "#/$defs/DashboardPublicationSort"
          },
          "maxItems": 10,
          "title": "Sort",
          "type": "array"
        },
        "max_output_rows": {
          "default": 1000,
          "maximum": 5000,
          "minimum": 1,
          "title": "Max Output Rows",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "DashboardPublicationBinding",
      "type": "object"
    },
    "DashboardPublicationFilterBinding": {
      "additionalProperties": false,
      "description": "Map a public filter to one field in a frozen publication dataset.",
      "properties": {
        "field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/DashboardPublicationFilterOperator",
          "default": "auto"
        }
      },
      "required": [
        "field"
      ],
      "title": "DashboardPublicationFilterBinding",
      "type": "object"
    },
    "DashboardPublicationFilterOperator": {
      "enum": [
        "auto",
        "equal",
        "less_than_or_equal",
        "greater_than_or_equal"
      ],
      "title": "DashboardPublicationFilterOperator",
      "type": "string"
    },
    "DashboardPublicationMeasure": {
      "additionalProperties": false,
      "properties": {
        "source_field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Source Field",
          "type": "string"
        },
        "output_field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Output Field",
          "type": "string"
        },
        "aggregation": {
          "$ref": "#/$defs/DashboardPublicationAggregation"
        },
        "denominator_field": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Field"
        },
        "scale": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "source_field",
        "output_field",
        "aggregation"
      ],
      "title": "DashboardPublicationMeasure",
      "type": "object"
    },
    "DashboardPublicationSort": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/DashboardSortDirection",
          "default": "ascending"
        }
      },
      "required": [
        "field"
      ],
      "title": "DashboardPublicationSort",
      "type": "object"
    },
    "DashboardRefreshPolicy": {
      "additionalProperties": false,
      "description": "Refresh behavior controlled by the dashboard owner.",
      "properties": {
        "refresh_on_open": {
          "default": false,
          "title": "Refresh On Open",
          "type": "boolean"
        },
        "interval_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 60,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Seconds"
        }
      },
      "title": "DashboardRefreshPolicy",
      "type": "object"
    },
    "DashboardSortDirection": {
      "enum": [
        "default",
        "ascending",
        "descending"
      ],
      "title": "DashboardSortDirection",
      "type": "string"
    },
    "DashboardStatus": {
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "title": "DashboardStatus",
      "type": "string"
    },
    "DashboardThemeDensity": {
      "enum": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "title": "DashboardThemeDensity",
      "type": "string"
    },
    "DashboardThemeFontScale": {
      "enum": [
        "compact",
        "standard",
        "large"
      ],
      "title": "DashboardThemeFontScale",
      "type": "string"
    },
    "DashboardThemeKpiStyle": {
      "enum": [
        "quiet",
        "accent",
        "solid"
      ],
      "title": "DashboardThemeKpiStyle",
      "type": "string"
    },
    "DashboardThemeMode": {
      "enum": [
        "light",
        "dark"
      ],
      "title": "DashboardThemeMode",
      "type": "string"
    },
    "DashboardThemeOverrides": {
      "additionalProperties": false,
      "description": "User-authored values layered on top of a visual theme preset.",
      "properties": {
        "primary_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Color"
        },
        "font_scale": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardThemeFontScale"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "density": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardThemeDensity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "card_radius": {
          "anyOf": [
            {
              "maximum": 28,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Card Radius"
        },
        "card_shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardThemeShadow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chart_palette": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chart Palette"
        },
        "kpi_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardThemeKpiStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "table_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashboardThemeTableStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "DashboardThemeOverrides",
      "type": "object"
    },
    "DashboardThemePreset": {
      "description": "Visual theme ids stored with the dashboard contract.\n\n``clean`` and ``business_blue`` are accepted only for historical schemas.\nNew Schema 1.4 documents use one of the four neutral canonical names.",
      "enum": [
        "clarity",
        "ocean",
        "warm",
        "graphite",
        "clean",
        "business_blue"
      ],
      "title": "DashboardThemePreset",
      "type": "string"
    },
    "DashboardThemeShadow": {
      "enum": [
        "none",
        "soft",
        "elevated"
      ],
      "title": "DashboardThemeShadow",
      "type": "string"
    },
    "DashboardThemeTableStyle": {
      "enum": [
        "plain",
        "striped",
        "divided"
      ],
      "title": "DashboardThemeTableStyle",
      "type": "string"
    },
    "DashboardVisualTheme": {
      "additionalProperties": true,
      "description": "Persisted theme selection; empty values keep legacy schemas valid.",
      "properties": {
        "preset": {
          "anyOf": [
            {
