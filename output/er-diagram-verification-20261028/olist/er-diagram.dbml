// Physical metadata export; inferred links are comments, not constraints.
// "_olist_import_manifest"
Table "_olist_import_manifest" {
  // "source_file" = "source_file"
  "source_file" "TEXT"
  // "table_name" = "table_name"
  "table_name" "TEXT" [not null]
  // "row_count" = "row_count"
  "row_count" "INTEGER" [not null]
  // "sha256" = "sha256"
  "sha256" "TEXT" [not null]
  // "imported_at" = "imported_at"
  "imported_at" "TEXT" [not null]
  indexes {
    ("source_file") [pk]
  }
}

// "customers"
Table "customers" {
  // "customer_id" = "customer_id"
  "customer_id" "TEXT"
  // "customer_unique_id" = "customer_unique_id"
  "customer_unique_id" "TEXT"
  // "customer_zip_code_prefix" = "customer_zip_code_prefix"
  "customer_zip_code_prefix" "INTEGER"
  // "customer_city" = "customer_city"
  "customer_city" "TEXT"
  // "customer_state" = "customer_state"
  "customer_state" "TEXT"
}

// "dataset_metadata"
Table "dataset_metadata" {
  // "key" = "key"
  "key" "TEXT"
  // "value" = "value"
  "value" "TEXT"
  indexes {
    ("key") [pk]
  }
}

// "geolocation"
Table "geolocation" {
  // "geolocation_zip_code_prefix" = "geolocation_zip_code_prefix"
  "geolocation_zip_code_prefix" "INTEGER"
  // "geolocation_lat" = "geolocation_lat"
  "geolocation_lat" "REAL"
  // "geolocation_lng" = "geolocation_lng"
  "geolocation_lng" "REAL"
  // "geolocation_city" = "geolocation_city"
  "geolocation_city" "TEXT"
  // "geolocation_state" = "geolocation_state"
  "geolocation_state" "TEXT"
}

// "metric_definitions"
Table "metric_definitions" {
  // "document" = "document"
  "document" "TEXT" [not null]
}

// "order_items"
Table "order_items" {
  // "order_id" = "order_id"
  "order_id" "TEXT"
  // "order_item_id" = "order_item_id"
  "order_item_id" "INTEGER"
  // "product_id" = "product_id"
  "product_id" "TEXT"
  // "seller_id" = "seller_id"
  "seller_id" "TEXT"
  // "shipping_limit_date" = "shipping_limit_date"
  "shipping_limit_date" "TEXT"
  // "price" = "price"
  "price" "REAL"
  // "freight_value" = "freight_value"
  "freight_value" "REAL"
}

// "order_payments"
Table "order_payments" {
  // "order_id" = "order_id"
  "order_id" "TEXT"
  // "payment_sequential" = "payment_sequential"
  "payment_sequential" "INTEGER"
  // "payment_type" = "payment_type"
  "payment_type" "TEXT"
  // "payment_installments" = "payment_installments"
  "payment_installments" "INTEGER"
  // "payment_value" = "payment_value"
  "payment_value" "REAL"
}

// "order_reviews"
Table "order_reviews" {
  // "review_id" = "review_id"
  "review_id" "TEXT"
  // "order_id" = "order_id"
  "order_id" "TEXT"
  // "review_score" = "review_score"
  "review_score" "INTEGER"
  // "review_comment_title" = "review_comment_title"
  "review_comment_title" "TEXT"
  // "review_comment_message" = "review_comment_message"
  "review_comment_message" "TEXT"
  // "review_creation_date" = "review_creation_date"
  "review_creation_date" "TEXT"
  // "review_answer_timestamp" = "review_answer_timestamp"
  "review_answer_timestamp" "TEXT"
}

// "orders"
Table "orders" {
  // "order_id" = "order_id"
  "order_id" "TEXT"
  // "customer_id" = "customer_id"
  "customer_id" "TEXT"
  // "order_status" = "order_status"
  "order_status" "TEXT"
  // "order_purchase_timestamp" = "order_purchase_timestamp"
  "order_purchase_timestamp" "TEXT"
  // "order_approved_at" = "order_approved_at"
  "order_approved_at" "TEXT"
  // "order_delivered_carrier_date" = "order_delivered_carrier_date"
  "order_delivered_carrier_date" "TEXT"
  // "order_delivered_customer_date" = "order_delivered_customer_date"
  "order_delivered_customer_date" "TEXT"
  // "order_estimated_delivery_date" = "order_estimated_delivery_date"
  "order_estimated_delivery_date" "TEXT"
}

// "product_category_translation"
Table "product_category_translation" {
  // "product_category_name" = "product_category_name"
  "product_category_name" "TEXT"
  // "product_category_name_english" = "product_category_name_english"
  "product_category_name_english" "TEXT"
}

// "products"
Table "products" {
  // "product_id" = "product_id"
  "product_id" "TEXT"
  // "product_category_name" = "product_category_name"
  "product_category_name" "TEXT"
  // "product_name_lenght" = "product_name_lenght"
  "product_name_lenght" "INTEGER"
  // "product_description_lenght" = "product_description_lenght"
  "product_description_lenght" "INTEGER"
  // "product_photos_qty" = "product_photos_qty"
  "product_photos_qty" "INTEGER"
  // "product_weight_g" = "product_weight_g"
  "product_weight_g" "REAL"
  // "product_length_cm" = "product_length_cm"
  "product_length_cm" "REAL"
  // "product_height_cm" = "product_height_cm"
  "product_height_cm" "REAL"
  // "product_width_cm" = "product_width_cm"
  "product_width_cm" "REAL"
}

// "sellers"
Table "sellers" {
  // "seller_id" = "seller_id"
  "seller_id" "TEXT"
  // "seller_zip_code_prefix" = "seller_zip_code_prefix"
  "seller_zip_code_prefix" "INTEGER"
  // "seller_city" = "seller_city"
  "seller_city" "TEXT"
  // "seller_state" = "seller_state"
  "seller_state" "TEXT"
}

